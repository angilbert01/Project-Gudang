# Environment Variables Example
# Salin file ini menjadi .env.local untuk konfigurasi lokal Anda:
# cp .env.example .env.local

# Kunci rahasia HMAC session token (Ganti dengan string acak panjang di production)
APP_SECRET=gudang-percetakan-secret-key-2026-v2-production

# Port aplikasi (default: 3000)
PORT=3000

